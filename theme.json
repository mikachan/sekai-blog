{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Hawthorn",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#fffdf7"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#2a2a22"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#3f4a35"
				},
				{
					"slug": "tint",
					"name": "Tint",
					"color": "#f1eee0"
				},
				{
					"slug": "rule",
					"name": "Rule",
					"color": "#c5c3a8"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#8a3b2a"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#6b6b5e"
				}
			]
		},
		"layout": {
			"contentSize": "640px",
			"wideSize": "960px"
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Space Mono",
					"fontFamily": "\"Space Mono\", ui-monospace, monospace",
					"fontFace": [
						{
							"fontFamily": "Space Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/space-mono-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Space Mono",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/space-mono-latin-700-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Atkinson Hyperlegible",
					"fontFamily": "\"Atkinson Hyperlegible\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Atkinson Hyperlegible",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Atkinson Hyperlegible",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible-latin-400-italic.woff2"
							]
						},
						{
							"fontFamily": "Atkinson Hyperlegible",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible-latin-700-normal.woff2"
							]
						},
						{
							"fontFamily": "Atkinson Hyperlegible",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible-latin-700-italic.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Extra small",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.2rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.4rem",
						"max": "1.75rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			]
		}
	},
	"styles": {
		"background": {
			"backgroundImage": {
				"url": "file:./assets/images/hawthorn.jpg"
			},
			"backgroundSize": "cover",
			"backgroundPosition": "50% 50%",
			"backgroundAttachment": "fixed"
		},
		"color": {
			"background": "var(--wp--preset--color--contrast)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "title-bar",
			"title": "Title bar",
			"area": "header"
		},
		{
			"name": "sidebar",
			"title": "Sidebar",
			"area": "uncategorized"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
